    "test": "vitest run",
    "test:watch": "vitest",
    "check-lines": "node scripts/check-lines.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
