{
  "name": "matchcutter",
  "version": "0.1.0",
  "description": "Browser-only text match cut video generator — newspaper clipping effect",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src tests vite.config.ts",
    "lint:fix": "eslint src tests vite.config.ts --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-lines": "node scripts/check-lines.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/old-standard-tt": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "jszip": "^3.10.2",
    "mp4-muxer": "^5.2.2"
  }
}
