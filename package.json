{
  "name": "matchcutter",
  "version": "0.1.0",
  "description": "Browser-only text match cut video generator — newspaper clipping effect",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
